<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- État pressé -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <corners android:radius="12dp" />
            <stroke
                android:width="6dp"
                android:color="@color/bleu_ciel" />
            <gradient
                android:angle="90"
                android:startColor="@color/orange"
                android:endColor="@color/vert"
                android:type="linear" />
        </shape>
    </item>

    <!-- État normal -->
    <item>
        <shape android:shape="oval">
            <corners android:radius="12dp" />
            <stroke
                android:width="6dp"
                android:color="@color/bleu_acier" />
            <gradient
                android:angle="270"
                android:startColor="@color/orange_fonce"
                android:endColor="@color/vert_fonce"
                android:type="linear" />
        </shape>
    </item>

</selector>
