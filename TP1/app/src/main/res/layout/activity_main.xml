<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">


    <Spinner
        android:id="@+id/spinnerListeGenre"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="25px"
        android:layout_marginTop="50px"
        android:layout_marginRight="25px"
        android:layout_weight="1"
        android:background="@drawable/effet_spinner"
        app:backgroundTint="@null" />

    <ListView
        android:id="@+id/listPlaylist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="25dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="50dp"
        android:layout_weight="8"
        android:background="@drawable/effet_list_view_frame"
        android:padding="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/btnActiviteBoomerang"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textColor="@drawable/text_change"
        android:background="@drawable/effet_bouton"
        app:backgroundTint= "@null"
        android:text="Options" />
</LinearLayout>